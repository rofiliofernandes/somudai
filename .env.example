# Copy to .env and fill in. Only EXPO_PUBLIC_ values go here: anyone who
# downloads the app can read them. Never put the service role key here.

# Supabase (dev project: somudai-dev)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in client IDs (IDs only; the secret lives in Supabase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# PostHog (use the "Somudai Dev" project key in dev)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_APP_ENV=development
